            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id\":\"O6\",\"productIds\":[\"P1\",\"P3\",\"P5\"]}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}", ""],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Récupérer les produits d'une commande",
          "request": {
            "method": "GET",
