{
  "info": {
    "name": "SmartShop API",
    "description": "Collection de requêtes pour tester l'API SmartShop",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Produits",
      "item": [
        {
          "name": "Récupérer tous les produits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}", ""],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Récupérer un produit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/P1",
              "host": ["{{base_url}}", ""],
              "path": ["api", "products", "P1"]
            }
          }
        },
        {
          "name": "Créer un produit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id\":\"P10\",\"brand\":\"Lenovo\",\"price\":950}"
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}", ""],
              "path": ["api", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "Commandes",
      "item": [
        {
          "name": "Récupérer une commande",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders/O1",
              "host": ["{{base_url}}", ""],
              "path": ["api", "orders", "O1"]
